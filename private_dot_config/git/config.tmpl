[user]
	name = stanly
	email = {{ .email | quote }}
[core]
    editor = nvim
    compression = 9
    preloadindex = true
[init]
    defaultBranch = main
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
    line-buffer-size = 1024
[merge]
    conflictStyle = zdiff3
[diff]
    colorMoved = default
